# Copy to .env and fill in. Never commit .env.

# --- Parent & residence ---------------------------------------------------
PARENT_NAME="Dad"
RESIDENCE_NAME="Maple Court"
# The building's coordinates. In Google Maps, right-click the building and click
# the numbers at the top of the menu to copy them ("lat, lon").
RESIDENCE_LAT=""
RESIDENCE_LON=""
# Find My fixes inside a building often drift 30-100 m; 150 m is a sane start.
GEOFENCE_RADIUS_METERS="150"

# --- Phone numbers (E.164) ------------------------------------------------
# Comma-separated; every caregiver gets the alerts and the call
CAREGIVER_PHONES="+15551234567,+15557654321"
FRONT_DESK_PHONE="+15559876543"
# Optional DTMF digits to dial after the front desk answers (IVR extension).
# "w" = 0.5 s pause, e.g. "ww1234"
FRONT_DESK_SEND_DIGITS=""
# Leave off until you have told the front desk to expect these calls
FRONT_DESK_CALL_ENABLED="false"

# --- Timing -----------------------------------------------------------------
CHECK_INTERVAL_SECONDS="300"
# Repeat caregiver alerts while away
SMS_REPEAT_SECONDS="300"
# Minimum gap between front-desk calls during one departure
FRONT_DESK_CALL_COOLDOWN_SECONDS="1800"
# Away fixes required before alerting (raise to 2 if you see phantom jumps)
AWAY_CONFIRM_FIXES="2"
# Warn caregivers if locations can't be fetched for this long
MONITOR_FAILURE_ALERT_SECONDS="1800"
# Warn caregiver if the card hasn't reported a new location this long
STALE_FIX_ALERT_SECONDS="14400"
# How far back to ask for locations (Airpinpoint source only)
LOOKBACK_HOURS="12"

# --- Caregiver alerts ---------------------------------------------------------
# Any of: push (ntfy app; free, no registration), sms (Twilio texts;
# needs A2P 10DLC registration or carriers block them). Comma-separated.
CAREGIVER_ALERT_METHODS="push"
NTFY_SERVER="https://ntfy.sh"
# Long random channel name - anyone who knows it can read the alerts.
NTFY_TOPIC="dadtracker-CHANGE-ME-to-a-long-random-string"
# Also ring every CAREGIVER_PHONES number once when an alert starts (voice works without registration)
CAREGIVER_CALL_ON_ALERT="true"

# --- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+15550001111"

# --- Airpinpoint (optional paid alternative; untested against the live API) ---
AIRPINPOINT_API_KEY=""
AIRPINPOINT_TRACKABLE_ID=""

# --- Location source ----------------------------------------------------------
# findmy = FindMy.py with the key exported by export-findmy (free)
LOCATION_SOURCE="findmy"
# The tag's .json key file from export-findmy (.local/keys/), copied here
FINDMY_KEY_FILE="secrets/tag.json"
# Apple session created by: .venv/bin/python findmy_login.py
FINDMY_ACCOUNT_FILE="secrets/findmy_account.json"

# --- Watchdog (dead-man's switch) ------------------------------------------------
# healthchecks.io check (period 5 min, grace 20 min). Pinged after every good
# Find My fetch; if pings stop, healthchecks.io alerts you (enable its ntfy
# integration with NTFY_TOPIC). Covers what this Mac can't report itself:
# being off/asleep, offline, or crashing. Strongly recommended.
WATCHDOG_PING_URL=""
